{
  "name": "@superduper/web",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "bun run codegen:check && bun run routes:check && bun run typecheck && bun run lint && bun run format:check && bun run deadcode && bun run test",
    "dev": "vite",
    "build": "vite build",
    "build:server": "bun build ./server/index.ts --target=bun --outdir=server-dist --production",
    "serve": "bun run server/index.ts",
    "codegen": "graphql-codegen --config codegen.config.ts",
    "codegen:check": "graphql-codegen --config codegen.config.ts --check",
    "routes:generate": "tsr generate",
    "routes:check": "bun run routes:generate && git diff --exit-code -- src/routeTree.gen.ts",
    "test": "bun test tests",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt -c ../../.oxfmtrc.json .",
    "format:check": "oxfmt -c ../../.oxfmtrc.json --check .",
    "deadcode": "knip --directory ../.. --workspace apps/web"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@hugeicons/core-free-icons": "4.2.3",
    "@hugeicons/react": "1.1.9",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "graphql": "16.14.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "7.2.0",
    "@graphql-codegen/client-preset": "6.1.0",
    "@graphql-typed-document-node/core": "3.2.0",
    "@happy-dom/global-registrator": "20.11.2",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-cli": "1.167.33",
    "@tanstack/router-plugin": "1.168.35",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "shadcn": "4.19.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vite": "8.1.6"
  }
}
