# Local development defaults. Compose and `bun run dev:seed` read this file; put personal
# overrides in `.env` (ignored by Git), which wins over these values.

COMPOSE_PROJECT_NAME=superduper

# Host ports. Inside the compose network the API listens on 4400 and Postgres on 5432.
PORT_API=4400
PORT_WEB=4401
PORT_POSTGRES=54400

# Development-only values; never use them outside your machine.
BETTER_AUTH_SECRET=local-development-only-better-auth-secret-0000
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=local-development-password

# Where `bun run dev:seed` sends its requests.
SEED_API_URL=http://localhost:4400
